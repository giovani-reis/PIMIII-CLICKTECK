@model PIMIII_CLICKTECK.Models.ViewModels.TelaUsuarioViewModel

@{
    Layout = null; // Ou use seu _Layout se preferir
}

<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>TechTrust | Técnicos Disponíveis</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap-grid.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <!-- Use ~/ para caminhos corretos no ASP.NET -->
    <link rel="stylesheet" href="~/estilos/dashboard.css">

    <style>
        /* --- Estilização do Modal de Agendamento --- */

        .tech-selection-info {
            color: #64748b;
            font-size: 0.95rem;
            margin-top: 5px;
        }

        /* Container do campo de texto */
        .form-group {
            display: flex;
            flex-direction: column;
            gap: 8px;
            margin-top: 10px;
        }

        .field-label {
            font-weight: 600;
            color: #334155;
            font-size: 0.9rem;
        }

        /* Textarea Premium */
        .custom-textarea {
            width: 100%;
            padding: 14px;
            border: 2px solid #e2e8f0;
            border-radius: 12px;
            font-family: 'Inter', sans-serif;
            font-size: 0.95rem;
            color: #1e293b;
            background-color: #f8fafc;
            resize: none;
            transition: all 0.25s ease;
            outline: none;

                    
        }

            .custom-textarea:focus {
                border-color: #3b82f6;
                background-color: #ffffff;
                box-shadow: 0 0 0 4px rgba(59, 130, 246, 0.1);
            }

        .helper-text {
            font-size: 0.8rem;
            color: #94a3b8;
        }

        /* Footer com botões lado a lado */
        .modal-footer-custom {
            display: flex;
            gap: 12px;
            margin-top: 25px;
            padding-top: 20px;
            border-top: 1px solid #f1f5f9;
        }

        /* Botão Cancelar */
        .btn-cancel-modal {
            flex: 1;
            padding: 12px;
            background: #ffffff;
            border: 1px solid #e2e8f0;
            border-radius: 10px;
            color: #64748b;
            font-weight: 600;
            cursor: pointer;
            transition: background 0.2s;
        }

            .btn-cancel-modal:hover {
                background: #f1f5f9;
                color: #0f172a;
            }

        /* Botão Confirmar */
        .btn-confirm-modal {
            flex: 2;
            padding: 12px;
            background: #0ea5e9;
            border: none;
            border-radius: 10px;
            color: white;
            font-weight: 700;
            cursor: pointer;
            transition: transform 0.2s, background 0.2s;
            box-shadow: 0 4px 6px -1px rgba(59, 130, 246, 0.2);
        }

            .btn-confirm-modal:hover {
                transform: translateY(-1px);
            }

            .btn-confirm-modal:active {
                transform: translateY(0);
            }

        .dropdown-menu {
            display: none; /* Escondido por padrão */
            position: absolute;
            top: 120%;
            right: 0;
            background-color: white;
            min-width: 200px;
            box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -2px rgba(0, 0, 0, 0.05);
            border-radius: 12px;
            border: 1px solid #e2e8f0;
            z-index: 1000;
            padding: 8px 0;
        }

            .dropdown-menu.show {
                display: block; /* Mostra quando tiver a classe .show */
            }

        .dropdown-header {
            padding: 8px 16px;
            font-size: 0.75rem;
            font-weight: 700;
            color: #94a3b8;
            text-transform: uppercase;
        }

        .dropdown-item {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 10px 16px;
            color: #334155;
            text-decoration: none;
            font-size: 0.9rem;
            transition: background 0.2s;
        }

            .dropdown-item:hover {
                background-color: #f1f5f9;
            }

        .dropdown-divider {
            height: 1px;
            background-color: #e2e8f0;
            margin: 8px 0;
        }

        .btn-logoff {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 10px 16px;
            color: #ef4444; /* Cor vermelha para sair */
            font-size: 0.9rem;
            font-weight: 600;
        }

            .btn-logoff:hover {
                background-color: #fef2f2;
            }

        .empty-state {
            grid-column: 1 / -1;
            /* Faz a div ocupar toda a largura do grid */
            display: none;
            /* Escondido por padrão */
            flex-direction: column;
            align-items: center;
            justify-content: center;
            padding: 60px 20px;
            background: var(--white);
            border-radius: 16px;
            border: 2px dashed #cbd5e1;
            text-align: center;
            animation: fadeIn 0.5s ease;
        }

            .empty-state svg {
                color: #94a3b8;
                margin-bottom: 15px;
                width: 48px;
                height: 48px;
            }

            .empty-state h3 {
                font-size: 18px;
                color: var(--text-main);
                margin-bottom: 8px;
            }

            .empty-state p {
                font-size: 14px;
                color: var(--text-light);
            }
    </style>
</head>
<body class="dashboard-body">

    <nav class="dash-navbar">
        <div class="dash-nav-container">
            <div class="logo" onclick="location.href='@Url.Action("Index", "AreaCliente")'" style="cursor: pointer;">
                <div class="logo-icon">CT</div>
                <span class="logo-text">Click<span>Tech</span></span>
            </div>

            <div class="user-menu">
                <div class="user-profile" id="user-profile-btn" style="position: relative; cursor: pointer;">
                    <span>Olá, @Model.Usuario.Nome</span>
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg>

                    <!-- Dropdown Menu Implementado -->
                    <div id="dropdown-menu" class="dropdown-menu">
                        <div class="dropdown-header">Minha Conta</div>
                        <div class="dropdown-divider"></div>

                        <a href="@Url.Action("Perfil", "AreaCliente")" class="dropdown-item">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
                            Meu Perfil
                        </a>
                        <a href="@Url.Action("MeusAgendamentos", "AreaCliente")" class="dropdown-item">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
                            Meus Atendimentos
                        </a>

                        <div class="dropdown-divider"></div>

                        <!-- Botão de Logoff com Form para segurança (opcional, mas recomendado no ASP.NET) -->
                        <form asp-controller="Login" asp-action="Sair" method="post" style="margin: 0;">
                            <button type="submit" class="btn-logoff" style="width: 100%; border: none; text-align: left; background: none; cursor: pointer;">
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path><polyline points="16 17 21 12 16 7"></polyline><line x1="21" y1="12" x2="9" y2="12"></line></svg>
                                Sair
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </nav>

    <main class="dash-main">
        <header class="dash-header">
            <div>
                <h1>Técnicos Disponíveis</h1>
                <p>Encontre o especialista ideal para o seu reparo agora mesmo.</p>
            </div>
            <div class="filters">
                <button class="filter-btn active" data-filter="todos">Todos</button>
                <button class="filter-btn" data-filter="smartphones">Smartphones</button>
                <button class="filter-btn" data-filter="notebooks">Notebooks</button>
                <button class="filter-btn" data-filter="hardware">Hardware</button>
                <button class="filter-btn" data-filter="tvs">TVs & Outros</button>
            </div>
        </header>

        <div class="tech-grid" id="tech-grid">
            @if (Model.Tecnico.Any())
            {
                @foreach (var tecnico in Model.Tecnico)
                {
                    string categoriasBusca = string.Join(" ", tecnico.Tags).ToLower();

                    <div class="tech-card"
                         data-category="@categoriasBusca"
                         data-description="@tecnico.Descricao">

                        <div class="tech-card-header">
                            <button class="btn-like" title="Curtir Técnico">
                                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
                                </svg>
                            </button>
                            <div class="tech-avatar-wrapper">
                                <img src="~/fotos_perfil/@tecnico.FotoUrl" alt="Técnico" class="tech-avatar">
                            </div>
                            <div class="tech-info">
                                <h3 class="tech-name">@tecnico.Nome</h3>
                                <span class="tech-role">Técnico</span>
                            </div>
                        </div>

                        <div class="tech-stats">
                            <div class="stat"><span class="star">★</span> @tecnico.Avaliacao.ToString("N1", System.Globalization.CultureInfo.InvariantCulture)</div>
                            <div class="stat">@tecnico.QtdReparos reparos</div>
                        </div>

                        <div class="tech-skills">
                            @foreach (var tag in tecnico.Tags)
                            {
                                <span class="skill-tag">@tag</span>
                            }
                        </div>

                        <div class="tech-actions">
                            <!-- Passamos os dados para o JS via atributos data -->
                            <button class="btn-outline view-profile-btn"
                                    data-nome="@tecnico.Nome"
                                    data-desc="@tecnico.Descricao"
                                    data-img="~/fotos_perfil/@tecnico.FotoUrl">
                                Ver Perfil
                            </button>
                            <button class="btn btn-primary w-100 py-2 fw-bold" onclick="prepararAgendamento('@tecnico.IdTecnico', '@tecnico.Nome')">
                                Agendar Reparo
                            </button>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="empty-state" style="display: flex;">
                    <h3>Nenhum técnico disponível</h3>
                    <p>volte mais tarde!</p>
                </div>
            }
        </div>
    </main>

    <!-- Modal permanece igual, mas será preenchido pelo dashboard.js atualizado -->
    <div id="profile-modal" class="modal-overlay">
        <div class="modal-content">
            <button class="close-modal">&times;</button>
            <div class="modal-header">
                <div class="modal-title">
                    <h2 id="modal-name">Nome do Técnico</h2>
                </div>
            </div>
            <div class="modal-body">
                <h3>Sobre</h3>
                <p id="modal-desc">Descrição carregada via JS...</p>
            </div>
        </div>
    </div>
    <div id="agendar-modal" class="modal-overlay">
        <div class="modal-content">
            <button type="button" class="close-modal" onclick="fecharAgendamento(event)">&times;</button>

            <div class="modal-header">
                <h2>Solicitar Reparo</h2>
                <p class="tech-selection-info">Técnico: <strong id="agendar-tecnico-nome"></strong></p>
            </div>

            <form asp-controller="AreaCliente" asp-action="CriarAtendimento" method="post">
                <!-- Campos Ocultos -->
                <input type="hidden" name="ClienteId" value="@Model.Usuario.Id" />
                <input type="hidden" id="input-tecnico-id" name="TecnicoId" value="" />
                <input type="hidden" name="Status" value="Solicitado" />

                <div class="modal-body">
                    <div class="form-group" style="margin-bottom: 15px;">
                        <label for="Aparelho" class="field-label">Qual é o seu aparelho?</label>
                        <input type="text" name="Aparelho" id="Aparelho"
                               class="custom-textarea"
                               maxlength="50"
                               placeholder="Ex: iPhone 13 Pro, Notebook Dell G15, etc."
                               required />
                    </div>
                    <div class="form-group">
                        <label for="Descricao" class="field-label">Descreva o problema do seu aparelho</label>
                        <textarea name="Descricao" id="Descricao" rows="5"
                                  class="custom-textarea"
                                  placeholder="Ex: Meu celular caiu e a tela não acende mais, mas ele ainda vibra..."
                                  maxlength="200"
                                  required></textarea>
                        <div style="display: flex; justify-content: space-between; margin-top: 5px;">
                            <small class="helper-text">Isso ajuda o técnico a preparar o orçamento.</small>
                            <small id="char-count" style="color: var(--text-light); font-size: 12px;">0 / 200</small>
                        </div>
                    </div>
                </div>

                <div class="modal-footer-custom">
                    <button type="button" class="btn-cancel-modal" onclick="fecharAgendamento(event)">
                        Cancelar
                    </button>
                    <button type="submit" class="btn-confirm-modal">
                        Confirmar Solicitação
                    </button>
                </div>
            </form>
        </div>
    </div>
    <div vw class="enabled">
        <div vw-access-button class="active"></div>
        <div vw-plugin-wrapper>
            <div class="vw-plugin-top-wrapper"></div>
        </div>
    </div>
    <script src="https://vlibras.gov.br/app/vlibras-plugin.js"></script>
    <script>
        new window.VLibras.Widget("https://vlibras.gov.br/app");
    </script>
    <script>
        const textarea = document.getElementById('Descricao');
        const charCount = document.getElementById('char-count');

        textarea.addEventListener('input', function () {
            const currentLength = textarea.value.length;
            charCount.textContent = `${currentLength} / 200`;

            // Feedback visual opcional quando atingir o limite
            if (currentLength >= 200) {
                charCount.style.color = '#ef4444'; // Vermelho
            } else {
                charCount.style.color = 'var(--text-light)';
            }
        });
    </script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/dashboard.js"></script>
</body>
</html>