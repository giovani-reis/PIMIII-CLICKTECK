@model IEnumerable<PIMIII_CLICKTECK.Models.ViewModels.MeusAgendamentosViewModel>
@{
    Layout = null;
}

<!doctype html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>TechTrust | Meus Agendamentos</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/estilos/agendamentos.css" asp-append-version="true">

    <!-- Ícones -->
    <link rel="apple-touch-icon" sizes="180x180" href="~/img/apple-touch-icon.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="~/img/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="~/img/favicon-16x16.png" />
    <link rel="manifest" href="~/img/site.webmanifest" />

    <style>
        /* Estilos adicionais para os novos botões e status diretamente na view por segurança */
        .btn-disabled {
            background-color: #f3f4f6;
            color: #9ca3af;
            border: 1px solid #e5e7eb;
            padding: 10px 16px;
            border-radius: 8px;
            font-weight: 600;
            cursor: not-allowed;
            text-align: center;
            width: 100%;
            display: block;
        }

        .actions-group {
            display: flex;
            gap: 10px;
            width: 100%;
        }

            .actions-group form {
                flex: 1;
            }

            .actions-group button {
                width: 100%;
            }

        .status-badge.canceled {
            background: #fee2e2;
            color: #ef4444;
        }

        .status-badge.pending-approval {
            background: #fef3c7;
            color: #d97706;
        }
    </style>
</head>
<body class="dashboard-body">

    <!-- Navbar Original -->
    <nav class="dash-navbar">
        <div class="dash-nav-container">
            <div class="logo" onclick="window.location.href = '@Url.Action("Index", "AreaCliente")'" style="cursor: pointer">
                <div class="logo-icon">T</div>
                <span class="logo-text">Tech<span>Trust</span></span>
            </div>
            <div class="user-menu">
                <div class="user-profile" onclick="window.location.href = '@Url.Action("Index", "AreaCliente")'" style="cursor: pointer;">
                    <span style="color: var(--primary-blue); font-weight: 600">← Voltar</span>
                </div>
            </div>
        </div>
    </nav>

    <main class="dash-main">
        <header class="dash-header">
            <div>
                <h1>Meus Agendamentos</h1>
                <p>Acompanhe o progresso dos seus reparos.</p>
            </div>
            <!-- Filtros atualizados baseados no Enum -->
            <div class="filters">
                <button class="filter-btn active" data-filter="todos">Todos</button>
                <button class="filter-btn" data-filter="solicitado">Solicitado</button>
                <button class="filter-btn" data-filter="pendenteaprovacao">Pendente Aprovação</button>
                <button class="filter-btn" data-filter="aprovado">Aprovado</button>
                <button class="filter-btn" data-filter="cancelado">Cancelado</button>
                <button class="filter-btn" data-filter="finalizado">Finalizado</button>
            </div>
        </header>

        <div class="appointments-list">
            @foreach (var item in Model)
            {
                <!-- O data-status ajuda o JavaScript a filtrar as divs -->
                <div class="appointment-card @(item.Status == "FINALIZADO" ? "done" : "")" data-status="@item.Status.ToLower()">
                    <div class="appointment-main">
                        <div class="tech-brief">
                            <img src="@item.TecnicoFoto" alt="@item.TecnicoNome" class="mini-avatar" />
                            <div>
                                <h4>@item.TecnicoNome</h4>
                                <span>@item.TecnicoEspecialidade</span>
                            </div>
                        </div>
                        <div class="service-info">
                            <p class="label">Serviço</p>
                            <p class="value">@item.ServicoDescricao</p>
                        </div>
                        <div class="date-info">
                            <p class="label">Data</p>
                            <p class="value">@item.DataAbertura.ToString("dd MMM • HH:mm")</p>
                        </div>
                        <div class="status-box">
                            @{
                                string statusClass = item.Status switch
                                {
                                    "FINALIZADO" => "completed",
                                    "CANCELADO" => "canceled",
                                    "SOLICITADO" => "pending",
                                    "PENDENTEAPROVACAO" => "pending-approval",
                                    "APROVADO" => "progress",
                                    _ => "pending"
                                };
                                string statusTexto = item.Status switch
                                {
                                    "FINALIZADO" => "Finalizado",
                                    "CANCELADO" => "Cancelado",
                                    "SOLICITADO" => "Solicitado",
                                    "PENDENTEAPROVACAO" => "Pendente Aprovação",
                                    "APROVADO" => "Aprovado",
                                    _ => item.Status
                                };
                            }
                            <span class="status-badge @statusClass">@statusTexto</span>
                        </div>
                    </div>

                    <!-- Renderização condicional dos botões -->
                    <div class="appointment-actions">

                        @if (item.Status == "SOLICITADO")
                        {
                            <form asp-action="CancelarAtendimento" asp-route-id="@item.AtendimentoId" method="post" style="width: 100%;">
                                <button type="submit" class="btn-outline-danger" style="width: 100%;" onclick="return confirm('Tem certeza que deseja cancelar esta solicitação?')">
                                    Cancelar
                                </button>
                            </form>
                        }
                        else if (item.Status == "PENDENTEAPROVACAO")
                        {
                            <div class="actions-group">
                                <form asp-action="AprovarAtendimento" asp-route-id="@item.AtendimentoId" method="post">
                                    <button type="submit" class="btn-primary">Aprovar</button>
                                </form>
                                <form asp-action="CancelarAtendimento" asp-route-id="@item.AtendimentoId" method="post">
                                    <button type="submit" class="btn-outline-danger" onclick="return confirm('Deseja realmente cancelar?')">Cancelar</button>
                                </form>
                            </div>
                        }
                        else if (item.Status == "APROVADO")
                        {
                            <button class="btn-outline btn-chat" style="width: 100%;">Abrir Chat</button>
                        }
                        else if (item.Status == "CANCELADO" || item.Status == "FINALIZADO")
                        {
                            <button class="btn-disabled" disabled>
                                @(item.Status == "CANCELADO" ? "Atendimento Cancelado" : "Atendimento Finalizado")
                            </button>

                            @* Mantive o botão de avaliar para caso seja finalizado *@
                            @if (item.Status == "FINALIZADO")
                            {
                                <button class="btn-primary btn-avaliar" data-tech="@item.TecnicoNome" data-id="@item.AtendimentoId" style="margin-top: 10px; width: 100%;">
                                    Avaliar Técnico
                                </button>
                            }
                        }
                    </div>
                </div>
            }
        </div>

        @* Modal de Avaliação *@
        <div id="modal-avaliacao" class="modal-overlay">
            <div class="modal-content evaluation-modal">
                <button class="close-modal" id="close-eval">&times;</button>
                <div class="eval-header">
                    <h2>Avaliar Serviço</h2>
                    <p>Como foi o atendimento de <strong id="eval-tech-name">--</strong>?</p>
                </div>
                <form id="form-avaliacao" method="post" asp-action="Avaliar" asp-controller="Atendimento">
                    <input type="hidden" name="AtendimentoId" id="eval-atendimento-id" />
                    <div class="rating-container">
                        <div class="rating-stars">
                            @for (int i = 5; i >= 1; i--)
                            {
                                <input type="radio" name="Nota" id="star@i" value="@i">
                                <label for="star@i">★</label>
                            }
                        </div>
                        <p class="rating-label">Toque nas estrelas para avaliar</p>
                    </div>
                    <div style="text-align:left; margin-top: 15px;">
                        <label for="eval-comment" style="font-size: 14px; font-weight: 600; display:block; margin-bottom: 5px;">Conte-nos mais (opcional)</label>
                        <textarea name="Comentario" id="eval-comment" placeholder="O que você achou da qualidade técnica e do prazo?" style="width: 100%; min-height: 100px; padding: 15px; border-radius: 12px; border: 1.5px solid var(--border-light); background: var(--bg-gray); resize: none; font-size: 14px;"></textarea>
                    </div>
                    <div style="display: flex; gap: 12px; margin-top: 30px;">
                        <button type="button" id="cancel-eval" style="flex: 1; background: var(--white); border: 1.5px solid var(--border-light); color: var(--text-light); padding: 14px; border-radius: 10px; font-weight: 600; cursor: pointer;">Agora não</button>
                        <button type="submit" style="flex: 2; background: var(--primary-blue); color: var(--white); border: none; padding: 14px; border-radius: 10px; font-weight: 700; cursor: pointer;">Enviar</button>
                    </div>
                </form>
            </div>
        </div>
    </main>

    <script src="~/scripts/agendamentos.js" asp-append-version="true"></script>
</body>
</html>