@model IEnumerable<PIMIII_CLICKTECK.Models.ViewModels.MeusAgendamentosViewModel>
@{
    Layout = null;
}

<!doctype html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>TechTrust | Meus Agendamentos</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/estilos/agendamentos.css" asp-append-version="true">

    <link rel="apple-touch-icon" sizes="180x180" href="~/img/apple-touch-icon.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="~/img/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="~/img/favicon-16x16.png" />
    <link rel="manifest" href="~/img/site.webmanifest" />

    <style>
        .btn-disabled {
            background-color: #f3f4f6;
            color: #9ca3af;
            border: 1px solid #e5e7eb;
            padding: 10px 16px;
            border-radius: 8px;
            font-weight: 600;
            cursor: not-allowed;
            text-align: center;
            width: 100%;
            display: block;
        }

        .actions-group {
            display: flex;
            gap: 10px;
            width: 100%;
        }

            .actions-group form {
                flex: 1;
            }

            .actions-group button {
                width: 100%;
            }

        .status-badge.canceled {
            background: #fee2e2;
            color: #ef4444;
        }

        .status-badge.pending-approval {
            background: #fef3c7;
            color: #d97706;
        }

        /* Ajuste para alinhar botões à direita conforme solicitado anteriormente */
        .appointment-actions {
            display: flex;
            justify-content: flex-end;
            gap: 12px;
            margin-top: 15px;
            width: 100%;
        }

            .appointment-actions button, .appointment-actions form {
                width: auto !important;
            }
    </style>
</head>
<body class="dashboard-body">

    <nav class="dash-navbar">
        <div class="dash-nav-container">
            <div class="logo" onclick="window.location.href = '@Url.Action("Index", "AreaCliente")'" style="cursor: pointer">
                <div class="logo-icon">T</div>
                <span class="logo-text">Tech<span>Trust</span></span>
            </div>
            <div class="user-menu">
                <div class="user-profile" onclick="window.location.href = '@Url.Action("Index", "AreaCliente")'" style="cursor: pointer;">
                    <span style="color: var(--primary-blue); font-weight: 600">← Voltar</span>
                </div>
            </div>
        </div>
    </nav>

    <main class="dash-main">
        <header class="dash-header">
            <div>
                <h1>Meus Agendamentos</h1>
                <p>Acompanhe o progresso dos seus reparos.</p>
            </div>
            <div class="filters">
                <button class="filter-btn active" data-filter="todos">Todos</button>
                <button class="filter-btn" data-filter="solicitado">Solicitado</button>
                <button class="filter-btn" data-filter="pendenteaprovacao">Pendente Aprovação</button>
                <button class="filter-btn" data-filter="aprovado">Aprovado</button>
                <button class="filter-btn" data-filter="cancelado">Cancelado</button>
                <button class="filter-btn" data-filter="finalizado">Finalizado</button>
            </div>
        </header>

        <div class="appointments-list">
            @foreach (var item in Model)
            {
                <div class="appointment-card @(item.Status == "FINALIZADO" ? "done" : "")" data-status="@item.Status.ToLower()">
                    <div class="appointment-main">
                        <div class="tech-brief">
                            <img src="@item.TecnicoFoto" alt="@item.TecnicoNome" class="mini-avatar" />
                            <div>
                                <h4>@item.TecnicoNome</h4>
                                <span>@item.TecnicoEspecialidade</span>
                            </div>
                        </div>
                        <div class="service-info">
                            <p class="label">Serviço</p>
                            <p class="value">@item.ServicoDescricao</p>
                        </div>
                        <div class="date-info">
                            <p class="label">Data</p>
                            <p class="value">@item.DataAbertura.ToString("dd MMM • HH:mm")</p>
                        </div>
                        <div class="status-box">
                            @{
                                string statusClass = item.Status switch
                                {
                                    "FINALIZADO" => "completed",
                                    "CANCELADO" => "canceled",
                                    "SOLICITADO" => "pending",
                                    "PENDENTEAPROVACAO" => "pending-approval",
                                    "APROVADO" => "progress",
                                    _ => "pending"
                                };
                                string statusTexto = item.Status switch
                                {
                                    "FINALIZADO" => "Finalizado",
                                    "CANCELADO" => "Cancelado",
                                    "SOLICITADO" => "Solicitado",
                                    "PENDENTEAPROVACAO" => "Pendente Aprovação",
                                    "APROVADO" => "Aprovado",
                                    _ => item.Status
                                };
                            }
                            <span class="status-badge @statusClass">@statusTexto</span>
                        </div>
                    </div>

                    <!-- INÍCIO DA LÓGICA REPLICADA DOS BOTÕES -->
                    <div class="appointment-actions">

                        @if (item.Status == "SOLICITADO")
                        {
                            <button class="btn-outline btn-chat">Abrir Chat</button>
                            <form asp-action="CancelarAtendimento" asp-route-id="@item.AtendimentoId" method="post">
                                <button type="submit" class="btn-outline-danger" onclick="return confirm('Tem certeza que deseja cancelar?')">
                                    Cancelar
                                </button>
                            </form>
                        }
                        else if (item.Status == "PENDENTEAPROVACAO")
                        {

                                <form asp-action="AprovarAtendimento" asp-route-id="@item.AtendimentoId" method="post">
                                    <button type="submit" class="btn-primary">Aprovar</button>
                                </form>
                                <form asp-action="CancelarAtendimento" asp-route-id="@item.AtendimentoId" method="post">
                                    <button type="submit" class="btn-outline-danger" onclick="return confirm('Deseja realmente cancelar?')">Cancelar</button>
                                </form>
                        }
                        else if (item.Status == "APROVADO")
                        {
                            <button class="btn-outline btn-chat">Abrir Chat</button>
                            <button class="btn-primary btn-detalhes" data-id="@item.AtendimentoId">Ver Detalhes</button>
                        }
                        else if (item.Status == "FINALIZADO")
                        {
                            <button class="btn-primary btn-avaliar" data-tech="@item.TecnicoNome" data-id="@item.AtendimentoId">
                                Avaliar Técnico
                            </button>
                        }
                        else if (item.Status == "CANCELADO")
                        {
                            <button class="btn-disabled" disabled>Atendimento Cancelado</button>
                        }
                    </div>
                    <!-- FIM DA LÓGICA REPLICADA -->
                </div>
            }
        </div>

        <!-- Modais permanecem os mesmos -->
        <div id="modal-avaliacao" class="modal-overlay">...</div>
        <div id="modal-detalhes" class="modal-overlay">...</div>
    </main>

    <script src="~/scripts/agendamentos.js" asp-append-version="true"></script>
</body>
</html>