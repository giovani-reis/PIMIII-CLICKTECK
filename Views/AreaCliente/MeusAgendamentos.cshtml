@model IEnumerable<PIMIII_CLICKTECK.Models.ViewModels.MeusAgendamentosViewModel>
@{
    Layout = null;
}

<!doctype html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>TechTrust | Meus Agendamentos</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/estilos/agendamentos.css" asp-append-version="true">

    <link rel="apple-touch-icon" sizes="180x180" href="~/img/apple-touch-icon.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="~/img/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="~/img/favicon-16x16.png" />
    <link rel="manifest" href="~/img/site.webmanifest" />

    <style>
        .btn-disabled {
            background-color: #f3f4f6;
            color: #9ca3af;
            border: 1px solid #e5e7eb;
            padding: 10px 16px;
            border-radius: 8px;
            font-weight: 600;
            cursor: not-allowed;
            text-align: center;
            width: 100%;
            display: block;
        }

        .actions-group {
            display: flex;
            gap: 10px;
            width: 100%;
        }

            .actions-group form {
                flex: 1;
            }

            .actions-group button {
                width: 100%;
            }

        .status-badge.canceled {
            background: #fee2e2;
            color: #ef4444;
        }

        .status-badge.pending-approval {
            background: #fef3c7;
            color: #d97706;
        }

        /* Ajuste para alinhar botões à direita conforme solicitado anteriormente */
        .appointment-actions {
            display: flex;
            justify-content: flex-end;
            gap: 12px;
            margin-top: 15px;
            width: 100%;
        }

            .appointment-actions button, .appointment-actions form {
                width: auto !important;
            }
            /**/
        .modal-overlay {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0,0,0,0.5);
            z-index: 1000;
            align-items: center;
            justify-content: center;
        }

            .modal-overlay.active {
                display: flex;
            }

        .modal-content {
            background: white;
            padding: 25px;
            border-radius: 12px;
            width: 90%;
            max-width: 400px;
        }

        .info-content-left {
            display: flex;
            align-items: center;
            gap: 40px; /* Espaço entre o bloco do técnico e a data */
            width: 100%;
        }

        /* Coluna da Direita (Status) */
        .status-box-right {
            flex-shrink: 0;
        }

        .appointment-main {
            display: flex;
            justify-content: space-between; /* Empurra o status para a direita */
            align-items: center;
            width: 100%;
            padding: 10px 0;
        }

    </style>
</head>
<body class="dashboard-body">

    <nav class="dash-navbar">
        <div class="dash-nav-container">
            <div class="logo" onclick="window.location.href = '@Url.Action("Index", "AreaCliente")'" style="cursor: pointer">
                <div class="logo-icon">T</div>
                <span class="logo-text">Tech<span>Trust</span></span>
            </div>
            <div class="user-menu">
                <div class="user-profile" onclick="window.location.href = '@Url.Action("Index", "AreaCliente")'" style="cursor: pointer;">
                    <span style="color: var(--primary-blue); font-weight: 600">← Voltar</span>
                </div>
            </div>
        </div>
    </nav>

    <main class="dash-main">
        <header class="dash-header">
            <div>
                <h1>Meus Agendamentos</h1>
                <p>Acompanhe o progresso dos seus reparos.</p>
            </div>
            <div class="filters">
                <button class="filter-btn active" data-filter="todos">Todos</button>
                <button class="filter-btn" data-filter="solicitado">Solicitado</button>
                <button class="filter-btn" data-filter="pendenteaprovacao">Pendente Aprovação</button>
                <button class="filter-btn" data-filter="aprovado">Aprovado</button>
                <button class="filter-btn" data-filter="cancelado">Cancelado</button>
                <button class="filter-btn" data-filter="finalizado">Finalizado</button>
            </div>
        </header>
        @if (TempData["MensagemSucesso"] != null)
        {
            <div class="alert-success" style="background: #d4edda; color: #155724; padding: 15px; border-radius: 8px;">
                @TempData["MensagemSucesso"]
            </div>
        }
        <div class="appointments-list">
            @foreach (var item in Model)
            {
                <div class="appointment-card @(item.Status == "FINALIZADO" ? "done" : "")" data-status="@item.Status.ToLower()">
                    <div class="appointment-main">
                        <div class="info-content-left">
                            <div class="tech-brief">
                                <img src="~/fotos_perfil/@item.TecnicoFoto" class="mini-avatar" />
                            </div>
                            <div>
                                <h4>@item.TecnicoNome</h4>
                                <span>@item.TecnicoEspecialidade</span>
                            </div>

                            <div class="date-info" style="margin-left: 10%">
                                <p class="label">Data</p>       
                                <p class="value">@item.DataAbertura.ToString("dd MMM • HH:mm")</p>
                            </div>

                        </div>
                        <div class="status-box-right">
                            <div class="status-box">
                                @{
                                    string statusClass = item.Status switch
                                    {
                                        "FINALIZADO" => "completed",
                                        "CANCELADO" => "canceled",
                                        "SOLICITADO" => "pending",
                                        "PENDENTEAPROVACAO" => "pending-approval",
                                        "APROVADO" => "progress",
                                        _ => "pending"
                                    };
                                    string statusTexto = item.Status switch
                                    {
                                        "FINALIZADO" => "Finalizado",
                                        "CANCELADO" => "Cancelado",
                                        "SOLICITADO" => "Solicitado",
                                        "PENDENTEAPROVACAO" => "Pendente Aprovação",
                                        "APROVADO" => "Aprovado",
                                        _ => item.Status
                                    };
                                }
                                <span class="status-badge @statusClass">@statusTexto</span>
                            </div>
                        </div>
                    </div>

                    <div class="appointment-actions">
                        <!-- Botão Ver Detalhes (Sempre visível à esquerda) -->
                        <button class="btn-outline btn-detalhes"
                                data-id="@item.AtendimentoId"
                                data-modelo="@item.Modelo"
                                data-motivo="@item.ServicoDescricao">
                            Ver Detalhes
                        </button>

                        @if (item.Status == "SOLICITADO")
                        {
                            <button class="btn-outline btn-chat">Abrir Chat</button>
                            <form asp-action="CancelarAtendimento" asp-route-id="@item.AtendimentoId" method="post">
                                <button type="submit" class="btn-outline-danger" onclick="return confirm('Tem certeza que deseja cancelar?')">
                                    Cancelar
                                </button>
                            </form>
                        }
                        else if (item.Status == "PENDENTEAPROVACAO")
                        {
                            <form asp-action="AprovarAtendimento" asp-route-id="@item.AtendimentoId" method="post">
                                <button type="submit" class="btn-primary">Aprovar</button>
                            </form>
                            <form asp-action="CancelarAtendimento" asp-route-id="@item.AtendimentoId" method="post">
                                <button type="submit" class="btn-outline-danger" onclick="return confirm('Deseja realmente cancelar?')">Recusar</button>
                            </form>
                        }
                        else if (item.Status == "APROVADO")
                        {
                            <button class="btn-outline btn-chat">Abrir Chat</button>
                        }
                        else if (item.Status == "FINALIZADO")
                        {
                            <button class="btn-primary btn-avaliar" data-tech="@item.TecnicoNome" data-id="@item.AtendimentoId">
                                Avaliar Técnico
                            </button>
                        }
                        else if (item.Status == "CANCELADO")
                        {
                            <button class="btn-disabled" disabled>Atendimento Cancelado</button>
                        }
                    </div>
                    <!-- FIM DA LÓGICA REPLICADA -->
                </div>
            }
        </div>

        <!-- Estrutura do Modal de Detalhes -->
        <div id="modal-detalhes" class="modal-overlay">
            <div class="modal-content">
                <h3>Detalhes do Aparelho</h3>
                <hr>
                <div class="info-group">
                    <label><strong>Modelo:</strong></label>
                    <p id="detalhe-modelo"></p>
                </div>
                <div class="info-group">
                    <label><strong>Motivo do Chamado:</strong></label>
                    <p id="detalhe-motivo"></p>
                </div>
                <button id="close-detalhes" class="btn-primary" style="margin-top: 20px;">Fechar</button>
            </div>
        </div>

        <!-- Modais permanecem os mesmos -->
        <div id="modal-avaliacao" class="modal-overlay">...</div>
    </main>

    <script src="~/scripts/agendamentos.js" asp-append-version="true"></script>
    <script>
        document.addEventListener("DOMContentLoaded", () => {
            console.log("Script TechTrust carregado e pronto."); // Se isso não aparecer, o caminho do arquivo no HTML está errado.

            const filterBtns = document.querySelectorAll(".filter-btn");
            const cards = document.querySelectorAll(".appointment-card");

            // --- LÓGICA DE FILTROS ---
            filterBtns.forEach((btn) => {
                btn.onclick = function () {
                    // Estilo visual dos botões
                    filterBtns.forEach((b) => b.classList.remove("active"));
                    this.classList.add("active");

                    const filter = this.getAttribute("data-filter").toLowerCase();

                    cards.forEach((card) => {
                        const cardStatus = card.getAttribute("data-status")?.toLowerCase() || "";

                        if (filter === "todos") {
                            card.style.display = "block";
                        }
                        else if (filter === "em-aberto") {
                            const isAberto = cardStatus !== "finalizado" && cardStatus !== "cancelado";
                            card.style.display = isAberto ? "block" : "none";
                        }
                        else if (filter === "concluidos") {
                            const isConcluido = cardStatus === "finalizado" || cardStatus === "cancelado";
                            card.style.display = isConcluido ? "block" : "none";
                        }
                        else {
                            // Filtros específicos (solicitado, aprovado, etc)
                            card.style.display = cardStatus === filter ? "block" : "none";
                        }
                    });
                };
            });

        // --- MODAL DE DETALHES ---
        const modalDet = document.getElementById("modal-detalhes");
        const txtModelo = document.getElementById("detalhe-modelo");
        const txtMotivo = document.getElementById("detalhe-motivo");

        document.querySelectorAll(".btn-detalhes").forEach((btn) => {
            btn.onclick = function() {
                // 1. Captura os dados dos atributos data- do botão clicado
                const modelo = this.getAttribute("data-modelo");
                const motivo = this.getAttribute("data-motivo");

                // 2. Injeta os textos nos elementos do modal
                if (txtModelo) txtModelo.innerText = modelo || "Não informado";
                if (txtMotivo) txtMotivo.innerText = motivo || "Não informado";

                // 3. Abre o modal
                modalDet?.classList.add("active");
            };
        });

        const closeDet = document.getElementById("close-detalhes");
        if (closeDet) {
            closeDet.onclick = () => modalDet?.classList.remove("active");
        }

        // --- LÓGICA PARA FECHAR CLICANDO FORA (Para ambos os modais) ---
        window.onclick = (event) => {
            // Se o alvo do clique for a overlay (fundo escuro), fecha o modal
            if (event.target.classList.contains('modal-overlay')) {
                event.target.classList.remove("active");

                // Se for o modal de avaliação, opcionalmente reseta o form
                if (event.target.id === "modal-avaliacao") {
                    document.getElementById("form-avaliacao")?.reset();
                }
            }
        };

            // --- MODAL DE AVALIAÇÃO ---
            const modalEval = document.getElementById("modal-avaliacao");
            const inputAtendimentoId = document.getElementById("eval-atendimento-id");
            const techNameSpan = document.getElementById("eval-tech-name");

            document.querySelectorAll(".btn-avaliar").forEach((btn) => {
                btn.onclick = function () {
                    if (techNameSpan) techNameSpan.innerText = this.getAttribute("data-tech");
                    if (inputAtendimentoId) inputAtendimentoId.value = this.getAttribute("data-id");
                    modalEval?.classList.add("active");
                };
            });

            const fecharAvaliacao = () => {
                modalEval?.classList.remove("active");
                document.getElementById("form-avaliacao")?.reset();
            };

            ["close-eval", "cancel-eval"].forEach(id => {
                const el = document.getElementById(id);
                if (el) el.onclick = fecharAvaliacao;
            });
        });
    </script>
</body>
</html>