@model PIMIII_CLICKTECK.Models.ViewModels.DashboardTecnicoViewModel
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>TechTrust | Dashboard Técnico</title>
    <link href="~/estilos/dashboard-tecnico.css" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800&display=swap" rel="stylesheet">
    <style>
        /* Força a exibição por clique e anula o comportamento antigo de hover se necessário */
        .user-profile {
            position: relative;
        }

        .dropdown-menu {
            display: none;
        }

            .dropdown-menu.show {
                display: block !important;
            }
    </style>
</head>
<body class="dashboard-body">

    <!-- NAVBAR REPLICADA -->
    <nav class="dash-navbar">
        <div class="dash-nav-container">
            <div class="logo" onclick="location.href='@Url.Action("Index", "AreaTecnico")'" style="cursor: pointer;">
                <div class="logo-icon">CT</div>
                <span class="logo-text">Click<span>Tech</span></span>
            </div>

            <div class="user-menu">
                <div class="notification-icon" style="position: relative; margin-right: 15px; display: flex; align-items: center;">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path><path d="M13.73 21a2 2 0 0 1-3.46 0"></path></svg>
                    @if (Model.AtendimentosPendentes.Count > 0)
                    {
                        <span class="badge-dot"></span>
                    }
                </div>

                <div class="user-profile" id="user-profile-btn" style="position: relative; cursor: pointer;">
                    <img src="~/fotos_perfil/@Model.Tecnico.TecnicoPerfil.FotoUrl" alt="Perfil" class="tech-avatar" style="width: 32px; height: 32px; border-radius: 50%; object-fit: cover;">
                    <span>Olá, @Model.Tecnico.Nome</span>
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg>

                    <!-- Dropdown Menu Estruturado -->
                    <div id="dropdown-menu" class="dropdown-menu">
                        <div class="dropdown-header">Minha Conta</div>
                        <div class="dropdown-divider"></div>

                        <a href="@Url.Action("Perfil", "AreaTecnico")" class="dropdown-item">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
                            Meu Perfil
                        </a>
                        <a href="@Url.Action("Index", "AreaTecnico")" class="dropdown-item">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
                            Meus Atendimentos
                        </a>

                        <div class="dropdown-divider"></div>

                        <form asp-controller="Login" asp-action="Sair" method="post" style="margin: 0;">
                            <button type="submit" class="btn-logoff" style="width: 100%; border: none; text-align: left; background: none; cursor: pointer;">
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path><polyline points="16 17 21 12 16 7"></polyline><line x1="21" y1="12" x2="9" y2="12"></line></svg>
                                Sair
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </nav>

    <!-- MAIN CONTENT -->
    <main class="dash-main">
        <header class="dash-header">
            <h1>Visão Geral</h1>
            <p>Olá, @Model.Tecnico.Nome. Bem-vindo de volta.</p>
        </header>

        <!-- ESTATÍSTICAS -->
        <div class="stats-grid">
            <!-- Card 1: Ganhos -->
            <div class="stat-card blue">
                <div class="stat-card-header">
                    <div class="stat-card-icon">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <line x1="12" y1="1" x2="12" y2="23"></line>
                            <path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path>
                        </svg>
                    </div>
                    <div class="stat-card-title">Ganhos Totais</div>
                </div>
                <div class="stat-card-body">
                    <div class="stat-card-value">@Model.GanhosTotais.ToString("C2")</div>
                    <div class="stat-card-desc">De @Model.TotalReparosConcluidos reparos concluídos</div>
                </div>
            </div>

            <!-- Card 2: Pendentes -->
            <div class="stat-card green">
                <div class="stat-card-header">
                    <div class="stat-card-icon">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                            <polyline points="22 4 12 14.01 9 11.01"></polyline>
                        </svg>
                    </div>
                    <div class="stat-card-title">Serviços Pendentes</div>
                </div>
                <div class="stat-card-body">
                    <div class="stat-card-value" id="pending-count">@Model.AtendimentosPendentes.Count</div>
                    <div class="stat-card-desc">Aguardando sua confirmação</div>
                </div>
            </div>

            <!-- Card 3: Avaliação -->
            <div class="stat-card yellow">
                <div class="stat-card-header">
                    <div class="stat-card-icon">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <circle cx="12" cy="12" r="10"></circle>
                            <polyline points="12 6 12 12 16 14"></polyline>
                        </svg>
                    </div>
                    <div class="stat-card-title">Avaliação Média</div>
                </div>
                <div class="stat-card-body">
                    <div class="stat-card-value">@Model.AvaliacaoMedia.ToString("F1")</div>
                    <div class="stat-card-desc">De @Model.TotalAvaliacoes avaliações</div>
                </div>
            </div>
        </div>

        <!-- LISTA DE SERVIÇOS -->
        <h2 class="section-title">Novas Solicitações</h2>
        <div class="services-grid">
            @if (Model.AtendimentosPendentes.Any())
            {
                foreach (var item in Model.AtendimentosPendentes)
                {
                    <div class="service-card">
                        <div class="service-header">
                            <div class="client-info">
                                <h3>@item.Cliente.Nome</h3>
                                <p>Cliente ClickTech</p>
                            </div>
                            <div class="service-date">Hoje</div>
                        </div>
                        <div class="service-details">
                            <strong>Aparelho: @item.Aparelho</strong>
                            <p>@item.Descricao</p>
                        </div>
                        <div class="service-actions">
                            <button class="btn-success" onclick="abrirModal('@item.Id', '@item.Aparelho')">Aceitar e Orçar</button>
                            <form asp-action="CancelarAtendimento" method="post" style="flex: 1; display: inline;">
                                <input type="hidden" name="id" value="@item.Id" />
                                <button type="submit" class="btn-outline" style="width: 100%;" onclick="return confirm('Tem certeza que deseja recusar este atendimento?')">
                                    Recusar
                                </button>
                            </form>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="empty-state" style="display: flex;">
                    <h3>Nenhum serviço pendente</h3>
                    <p>Tudo em dia por aqui!</p>
                </div>
            }
        </div>
    </main>

    <!-- MODAL -->
    <div id="modalOrcamento" class="modal-overlay">
        <div class="modal-content">
            <button class="close-modal" onclick="fecharModal()">&times;</button>
            <h2 style="margin-bottom: 10px;">Enviar Orçamento</h2>
            <p id="txtAparelho" style="color: var(--text-light); margin-bottom: 20px;"></p>

            <form asp-action="EnviarOrcamento" method="post">
                <input type="hidden" name="AtendimentoId" id="atendimentoId">

                <div class="modal-form-group">
                    <label>Valor Estimado (R$)</label>
                    <input type="number" name="Valor" step="0.01" placeholder="Ex: 150,00" required>
                </div>

                <div class="modal-form-group">
                    <label>Observações e Peças</label>
                    <textarea name="Observacao" rows="4" placeholder="Descreva o defeito e a solução..." required></textarea>
                </div>

                <div class="service-actions">
                    <button type="submit" class="btn-primary">Enviar Proposta ao Cliente</button>
                </div>
            </form>
        </div>
    </div>
    <div vw class="enabled">
        <div vw-access-button class="active"></div>
        <div vw-plugin-wrapper>
            <div class="vw-plugin-top-wrapper"></div>
        </div>
    </div>
    <script src="https://vlibras.gov.br/app/vlibras-plugin.js"></script>
    <script>
        new window.VLibras.Widget("https://vlibras.gov.br/app");
    </script>
    <script>
        // Logica de clique do Dropdown da Navbar
        const profileBtn = document.getElementById('user-profile-btn');
        const dropdownMenu = document.getElementById('dropdown-menu');

        profileBtn.addEventListener('click', function(event) {
            event.stopPropagation();
            dropdownMenu.classList.toggle('show');
        });

        // Fecha se clicar em qualquer lugar fora do menu
        window.addEventListener('click', function() {
            if (dropdownMenu.classList.contains('show')) {
                dropdownMenu.classList.remove('show');
            }
        });

        // Modais de Orçamento
        function abrirModal(id, aparelho) {
            document.getElementById('atendimentoId').value = id;
            document.getElementById('txtAparelho').innerText = "Aparelho: " + aparelho;
            document.getElementById('modalOrcamento').classList.add('active');
        }

        function fecharModal() {
            document.getElementById('modalOrcamento').classList.remove('active');
        }

        window.onclick = function(event) {
            let modal = document.getElementById('modalOrcamento');
            if (event.target == modal) fecharModal();
        }
    </script>
</body>
</html>