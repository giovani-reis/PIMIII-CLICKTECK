@model IEnumerable<PIMIII_CLICKTECK.Models.ViewModels.MeusAgendamentosTecnicoViewModel>
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="pt-br">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>TechTrust | Meus Serviços</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;800&display=swap" rel="stylesheet" />
    <link rel="icon" type="image/png" href="~/img/favicon-32x32.png" />

    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/estilos/meus-servicos.css" asp-append-version="true">
</head>

<body class="dashboard-body">

    <nav class="dash-navbar">
        <div class="dash-nav-container">
            <div class="logo" onclick="window.location.href='@Url.Action("Index", "AreaTecnico")';" style="cursor:pointer;">
                <div class="logo-icon">CT</div>
                <span class="logo-text">Click<span>Tech</span></span>
            </div>

            <div class="user-menu">
                <a href="@Url.Action("Index", "AreaTecnico")" class="btn-voltar">
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none"
                         stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="19" y1="12" x2="5" y2="12"></line>
                        <polyline points="12 19 5 12 12 5"></polyline>
                    </svg>
                    Voltar ao Painel
                </a>
            </div>
        </div>
    </nav>

    <main class="dash-main">
        <div class="dash-header-flex">
            <div class="dash-header">
                <h1>Meus Serviços</h1>
                <p>Gerencie seus reparos: acompanhe o progresso e finalize.</p>
            </div>

            <div class="status-filters">
                <button class="filter-btn" data-filter="todos">Todos</button>
                <button class="filter-btn active" data-filter="aprovado">Em Andamento</button>
                <button class="filter-btn" data-filter="pendenteaprovacao">Pendentes</button>
                <button class="filter-btn" data-filter="finalizado">Concluídos</button>
                <button class="filter-btn" data-filter="cancelado">Cancelados</button>
            </div>
        </div>

        @if (TempData["MensagemSucesso"] != null)
        {
            <div style="background: #dcfce7; color: #16a34a; padding: 15px; border-radius: 8px; margin-bottom: 20px; font-weight: 500;">
                @TempData["MensagemSucesso"]
            </div>
        }

        <div class="services-grid" id="accepted-services-grid">

            @foreach (var servico in Model)
            {
                <div class="service-card" data-status="@servico.Status.ToLower()">
                    <div class="service-header">
                        <div class="client-info">
                            <h3>@servico.ClienteNome</h3>

                            @if (servico.Status == "APROVADO")
                            {
                                <span class="status-badge status-in-progress">#@servico.AtendimentoId</span>
                                <span class="status-badge status-in-progress">Em Andamento</span>
                            }
                            else if (servico.Status == "PENDENTEAPROVACAO")
                            {
                                <span class="status-badge status-scheduled">#@servico.AtendimentoId</span>
                                <span class="status-badge status-scheduled">Aguardando Cliente</span>
                            }
                            else if (servico.Status == "FINALIZADO")
                            {
                                <span class="status-badge status-completed">#@servico.AtendimentoId</span>
                                <span class="status-badge status-completed">Concluído</span>
                            }
                            else if (servico.Status == "CANCELADO")
                            {
                                <span class="status-badge status-canceled">#@servico.AtendimentoId</span>
                                <span class="status-badge status-canceled">Cancelado</span>
                            }
                        </div>
                        <div class="service-date">
                            Abertura:<br>@servico.DataAbertura.ToString("dd/MM/yyyy")<br />@servico.DataAbertura.ToString("HH:mm")
                            @* A data de fechamento foi removida daqui *@
                        </div>
                    </div>

                    @* Alterado para usar a estrutura e classes do header *@
                    <div class="service-header" style="border-bottom: 0px solid var(--border-color); margin-bottom:0;">
                        <div class="client-info">
                            <strong>Aparelho: @servico.Aparelho</strong>
                            <p style="margin-top: 5px; color: var(--text-light);">@servico.Descricao</p>

                        </div>

                        @* Lado direito contendo apenas a data de fechamento se ela existir *@
                        <div class="service-date">
                            @if (servico.DataConclusao.HasValue)
                            {
                                <div>Fechamento:<br>@servico.DataConclusao.Value.ToString("dd/MM/yyyy")<br />@servico.DataConclusao.Value.ToString("HH/mm")</div>
                            }
                        </div>
                    </div>
                    <div class="service-details">
                        @if (servico.ValorOrcamento.HasValue)
                        {
                            <div class="agreed-price" style="margin-top: 10px;">
                                Valor do Orçamento: <span>@(((decimal)servico.ValorOrcamento).ToString("C2"))</span>
                            </div>
                        }
                        else
                        {
                            <div class="agreed-price" style="margin-top: 10px;">
                                Valor do Orçamento: <span>R$--,--</span>
                            </div>
                        }
                    </div>

                    <div class="service-actions">
                        @if (servico.Status == "APROVADO")
                        {
                            <button class="btn-primary btn-abrir-finalizar" data-id="@servico.AtendimentoId">
                                Finalizar Serviço
                            </button>
                        }
                        else if (servico.Status == "PENDENTEAPROVACAO")
                        {
                            <button class="btn-disabled" disabled>Aguardando Aprovação</button>
                        }
                    </div>
                </div>
            }

            <div id="empty-state" class="empty-state">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                     stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="10"></circle>
                    <path d="M16 16s-1.5-2-4-2-4 2-4 2"></path>
                    <line x1="9" y1="9" x2="9.01" y2="9"></line>
                    <line x1="15" y1="9" x2="15.01" y2="9"></line>
                </svg>
                <h3>Nenhum serviço</h3>
                <p>Você não possui serviços nesta categoria no momento.</p>
            </div>

        </div>
    </main>

    <div id="finish-modal" class="modal-overlay">
        <div class="modal-content">
            <button class="close-modal" id="close-finish-modal">&times;</button>
            <svg style="color: var(--success-green); width: 64px; height: 64px; margin: 0 auto 15px auto; display: block;"
                 xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor"
                 stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round"
                      d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            <h2 style="font-size: 22px; color: var(--text-main); margin-bottom: 10px;">Concluir Reparo?</h2>
            <p style="font-size: 14px; color: var(--text-light); margin-bottom: 25px;">
                Ao confirmar, o serviço será marcado como concluído e movido para o seu histórico.
            </p>

            <form asp-controller="AreaTecnico" asp-action="FinalizarServico" method="post">
                <input type="hidden" name="atendimentoId" id="input-finalizar-id" value="" />

                <div style="display: flex; gap: 10px;">
                    <button type="button" class="btn-disabled" id="cancel-finish"
                            style="flex: 1; padding: 12px; border-radius: 8px; border:none; cursor:pointer;">
                        Cancelar
                    </button>
                    <button type="submit" class="btn-primary" style="flex: 1; padding: 12px; border-radius: 8px; border:none;">
                        Sim, Finalizar
                    </button>
                </div>
            </form>
        </div>
    </div>

    <footer class="footer">
        <div class="footer-bottom">
            <div class="container">
                <p>© 2026 ClickTech. Todos os direitos reservados.</p>
            </div>
        </div>
    </footer>

    <div vw class="enabled">
        <div vw-access-button class="active"></div>
        <div vw-plugin-wrapper>
            <div class="vw-plugin-top-wrapper"></div>
        </div>
    </div>
    <script src="https://vlibras.gov.br/app/vlibras-plugin.js"></script>
    <script>
        new window.VLibras.Widget("https://vlibras.gov.br/app");
    </script>

    <script>
        document.addEventListener("DOMContentLoaded", () => {
            const filterBtns = document.querySelectorAll(".filter-btn");
            const cards = document.querySelectorAll(".service-card");
            const emptyState = document.getElementById("empty-state");

            // Função que aplica o filtro
            function applyFilter(filterValue) {
                let countVisible = 0;

                cards.forEach(card => {
                    if (filterValue === "todos" || card.getAttribute("data-status") === filterValue) {
                        card.style.display = "block";
                        countVisible++;
                    } else {
                        card.style.display = "none";
                    }
                });

                // Lógica da mensagem de "Nenhum Serviço" (Empty State)
                if (countVisible === 0) {
                    emptyState.style.display = "flex";
                } else {
                    emptyState.style.display = "none";
                }
            }

            // Inicia clicando na aba "Em Andamento" (Aprovado)
            applyFilter("aprovado");

            // Evento de clique nas abas
            filterBtns.forEach(btn => {
                btn.addEventListener("click", function() {
                    filterBtns.forEach(b => b.classList.remove("active"));

                    this.classList.add("active");

                    const filter = this.getAttribute("data-filter");
                    applyFilter(filter);
                });
            });

            // LÓGICA DO MODAL DE FINALIZAR
            const modalFinish = document.getElementById("finish-modal");
            const inputFinishId = document.getElementById("input-finalizar-id");

            document.querySelectorAll(".btn-abrir-finalizar").forEach(btn => {
                btn.addEventListener("click", function() {
                    const id = this.getAttribute("data-id");
                    inputFinishId.value = id;
                    modalFinish.classList.add("active");
                });
            });

            const fecharModal = () => {
                modalFinish.classList.remove("active");
                inputFinishId.value = "";
            };

            document.getElementById("close-finish-modal").addEventListener("click", fecharModal);
            document.getElementById("cancel-finish").addEventListener("click", fecharModal);

            window.addEventListener("click", (e) => {
                if (e.target === modalFinish) {
                    fecharModal();
                }
            });
        });
    </script>
</body>
</html>