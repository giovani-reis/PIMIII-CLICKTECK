@model PIMIII_CLICKTECK.Models.ViewModels.PerfilTecnicoViewModel

@{
    Layout = null;
}

<!doctype html>
<html lang="pt-br">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>ClickTech | Perfil do Técnico</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
          rel="stylesheet" />

    <link rel="stylesheet"
          href="~/estilos/perfil-tecnico.css" />

    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

          <style>
        .toggle-btn {
            border: none;
            padding: 12px 20px;
            border-radius: 10px;
            font-weight: 600;
            cursor: pointer;
            transition: .3s;
        }

            .toggle-btn.ativo {
                background: #22c55e;
                color: white;
            }

            .toggle-btn.inativo {
                background: #ef4444;
                color: white;
            }

            .toggle-btn:hover {
                opacity: .9;
            }

        .tech-skills {
            display: flex;
            flex-wrap: wrap;
            gap: 8px;
            margin-bottom: 25px;
        }

        .especialidades-container {
            background: #f8fafc;
            border: 1px solid #e2e8f0 !important;
        }

        .especialidade-item {
            transition: all 0.2s ease;
            cursor: pointer;
        }

            .especialidade-item:hover {
                transform: translateY(-2px);
                border-color: #2563eb !important;
            }

            .especialidade-item input[type="checkbox"] {
                cursor: pointer;
            }

            .especialidade-item label {
                cursor: pointer;
                margin: 0;
                font-weight: 500;
            }

        .especialidades-container::-webkit-scrollbar {
            width: 8px;
        }

        .especialidades-container::-webkit-scrollbar-track {
            background: #f1f5f9;
        }

        .especialidades-container::-webkit-scrollbar-thumb {
            background: #94a3b8;
            border-radius: 20px;
        }

            .especialidades-container::-webkit-scrollbar-thumb:hover {
                background: #64748b;
            }
          </style>
</head>

<body class="dashboard-body">

    <nav class="dash-navbar">

        <div class="dash-nav-container">

            <div class="logo"
                 onclick="window.location.href='@Url.Action("Index", "AreaTecnico")'"
                 style="cursor:pointer">

                <div class="logo-icon">
                    CT
                </div>

                <span class="logo-text">
                    Click<span>Tech</span>
                </span>

            </div>

            <div class="user-menu">

                <a href="@Url.Action("Index", "AreaTecnico")"
                   class="btn-voltar">

                    <svg xmlns="http://www.w3.org/2000/svg"
                         width="18"
                         height="18"
                         viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="2"
                         stroke-linecap="round"
                         stroke-linejoin="round">

                        <line x1="19"
                              y1="12"
                              x2="5"
                              y2="12"></line>

                        <polyline points="12 19 5 12 12 5"></polyline>

                    </svg>

                    Voltar ao Painel

                </a>

            </div>

        </div>

    </nav>

    <main class="dash-main profile-page">

        <div class="container profile-layout">

            <!-- SIDEBAR -->
            <aside class="profile-sidebar">

                <div class="sidebar-user-info">

                    <img src="~/fotos_perfil/@(@Model.FotoPerfil ?? "default-avatar.jpg")"
                         alt="Foto de Perfil"
                         id="sidebar-img"
                         class="sidebar-avatar" />

                    <h3>@Model.Nome</h3>

                    <p>Técnico Parceiro</p>

                </div>

                <ul class="sidebar-nav">

                    <li>

                        <a href="#"
                           class="nav-tab active"
                           data-target="aba-dados">

                            Dados Profissionais

                        </a>

                    </li>

                    <li>

                        <a href="#"
                           class="nav-tab"
                           data-target="aba-especialidades">

                            Especialidades

                        </a>

                    </li>

                    <li>

                        <a href="#"
                           class="nav-tab"
                           data-target="aba-seguranca">

                            Segurança

                        </a>

                    </li>

                </ul>

            </aside>

            <!-- CONTEÚDO -->
            <section class="profile-content">

                <!-- DADOS -->
                <div id="aba-dados"
                     class="tab-pane active">

                    <header class="content-header">

                        <h2>
                            Dados Profissionais
                        </h2>

                        <p>
                            Atualize suas informações profissionais.
                        </p>

                    </header>

                    <div class="avatar-upload-section">

                        <img src="~/fotos_perfil/@(@Model.FotoPerfil ?? "default-avatar.jpg")"
                             alt="Sua Foto"
                             id="main-avatar"
                             class="current-avatar" />

                        <div class="avatar-actions">

                            <form method="post"
                                  enctype="multipart/form-data"
                                  action="@Url.Action("AtualizarFoto", "AreaTecnico")">

                                <input type="file"
                                       name="NovaFoto"
                                       class="form-input"
                                       required />

                                <br />

                                <button type="submit"
                                        class="btn-outline">

                                    Trocar Foto

                                </button>

                            </form>

                            <form method="post"
                                  action="@Url.Action("RemoverFoto", "AreaTecnico")">

                                <button type="submit"
                                        class="btn-text-danger">

                                    Remover Foto

                                </button>

                            </form>

                        </div>

                    </div>
                    <hr class="divider" />

                    <form method="post"
                          action="@Url.Action("AtualizarDados", "AreaTecnico")"
                          class="profile-form">

                        <div class="form-row">

                            <div class="form-group">

                                <label>
                                    Nome
                                </label>

                                <input type="text"
                                       name="Nome"
                                       value="@Model.Nome"
                                       class="form-input" />

                            </div>

                        </div>

                        <div class="form-row">

                            <div class="form-group">

                                <label>
                                    Email
                                </label>

                                <input type="email"
                                       name="Email"
                                       value="@Model.Email"
                                       class="form-input" />

                            </div>

                        </div>

                        <div class="form-row">

                            <div class="form-group">

                                <label>
                                    Resumo Profissional
                                </label>

                                <textarea name="Bio"
                                          rows="4"
                                          class="form-input">@Model.Bio</textarea>

                            </div>

                        </div>
                        <div class="form-row">

                            <div class="form-group">

                                <label>
                                    Disponibilidade
                                </label>

                                <input type="hidden"
                                       id="Disponivel"
                                       name="Disponivel"
                                       value="@Model.Disponivel.ToString().ToLower()" />

                                <button type="button"
                                        id="btnDisponibilidade"
                                        class="toggle-btn @(Model.Disponivel ? "ativo" : "inativo")">

                                    @(Model.Disponivel
                                                                        ? "🟢 Disponível"
                                                                        : "🔴 Indisponível")

                                </button>

                            </div>

                        </div>
                        <div class="form-actions">

                            <button type="submit"
                                    class="btn-primary">

                                Salvar Alterações

                            </button>

                        </div>

                    </form>

                </div>

                <!-- ESPECIALIDADES -->
                <div id="aba-especialidades"
                     class="tab-pane">

                    <header class="content-header">

                        <h2>
                            Especialidades
                        </h2>

                        <p>
                            Gerencie suas especialidades técnicas.
                        </p>

                    </header>

                    <form method="post"
                          action="@Url.Action("AtualizarEspecialidades","AreaTecnico")"
                          class="profile-form">

                        <div class="form-group">

                            <label>
                                Especialidades
                            </label>

                            <div class="col-12">

                                <label class="form-label fw-bold mb-2">
                                    Selecione suas especialidades
                                </label>

                                <div class="especialidades-container p-3 border rounded bg-light"
                                     style="max-height: 350px; overflow-y: auto;">

                                    <div class="row g-2">

                                        @foreach (var especialidade in Model.TodasEspecialidades)
                                        {
                                            <div class="col-md-6">

                                                <div class="especialidade-item bg-white border rounded px-3 py-2 shadow-sm d-flex align-items-center">

                                                    <input class="form-check-input me-2"
                                                           type="checkbox"
                                                           name="EspecialidadesSelecionadas"
                                                           value="@especialidade.Id"
                                                           id="esp-@especialidade.Id"
                                                           @(Model.EspecialidadesSelecionadas.Contains(especialidade.Id) ? "checked" : "") />

                                                    <label class="form-check-label flex-grow-1"
                                                           for="esp-@especialidade.Id">

                                                        @especialidade.Nome

                                                    </label>

                                                </div>

                                            </div>
                                        }

                                    </div>

                                </div>

                                <small class="text-muted">
                                    Marque todas as especialidades que você atende.
                                </small>

                            </div>

                        </div>

                        <div class="form-actions">

                            <button type="submit"
                                    class="btn-primary">

                                Salvar Especialidades

                            </button>

                        </div>

                    </form>

                </div>

                <!-- SEGURANÇA -->
                <div id="aba-seguranca"
                     class="tab-pane">

                    <header class="content-header">

                        <h2>
                            Segurança
                        </h2>

                        <p>
                            Atualize sua senha de acesso.
                        </p>

                    </header>

                    <form method="post"
                          action="@Url.Action("AtualizarSenha", "AreaTecnico")"
                          class="profile-form">

                        <div class="form-row">

                            <div class="form-group">

                                <label>
                                    Senha Atual
                                </label>

                                <input type="password"
                                       name="SenhaAtual"
                                       class="form-input"
                                       placeholder="Digite sua senha atual" />

                            </div>

                        </div>

                        <div class="form-row">

                            <div class="form-group">

                                <label>
                                    Nova Senha
                                </label>

                                <input type="password"
                                       name="NovaSenha"
                                       class="form-input"
                                       placeholder="Digite a nova senha" />

                            </div>

                            <div class="form-group">

                                <label>
                                    Confirmar Nova Senha
                                </label>

                                <input type="password"
                                       name="ConfirmarSenha"
                                       class="form-input"
                                       placeholder="Confirme a nova senha" />

                            </div>

                        </div>

                        <div class="form-actions">

                            <button type="submit"
                                    class="btn-primary">

                                Atualizar Senha

                            </button>

                        </div>

                    </form>

                </div>

            </section>

        </div>

    </main>

    @if (TempData["Sucesso"] != null)
    {
        <script>
            Swal.fire({
                icon: 'success',
                title: 'Sucesso',
                text: '@TempData["Sucesso"]',
                confirmButtonText: 'OK'
            });
        </script>
    }
    @if (TempData["Erro"] != null)
    {
        <script>
            Swal.fire({
                icon: 'error',
                title: 'Erro',
                text: '@TempData["Erro"]',
                confirmButtonText: 'OK'
            });
        </script>
    }
    <div vw class="enabled">
        <div vw-access-button class="active"></div>
        <div vw-plugin-wrapper>
            <div class="vw-plugin-top-wrapper"></div>
        </div>
    </div>
    <script src="https://vlibras.gov.br/app/vlibras-plugin.js"></script>
    <script>
        new window.VLibras.Widget("https://vlibras.gov.br/app");
    </script>
    <script>

        const tabs = document.querySelectorAll(".nav-tab");
        const panes = document.querySelectorAll(".tab-pane");

        tabs.forEach(tab => {

            tab.addEventListener("click", function (e) {

                e.preventDefault();

                tabs.forEach(t => t.classList.remove("active"));
                panes.forEach(p => p.classList.remove("active"));

                this.classList.add("active");

                const target = this.getAttribute("data-target");

                document
                    .getElementById(target)
                    .classList.add("active");

            });

        });

        const formSenha = document.querySelector(
            'form[action*="AtualizarSenha"]'
        );

        if (formSenha) {

            formSenha.addEventListener("submit", function (e) {

                const novaSenha =
                    document.querySelector(
                        'input[name="NovaSenha"]'
                    ).value;

                const confirmarSenha =
                    document.querySelector(
                        'input[name="ConfirmarSenha"]'
                    ).value;

                if (novaSenha !== confirmarSenha) {

                    e.preventDefault();

                    alert("A confirmação da senha não corresponde à nova senha.");

                }

            });

        }

        const btnDisponibilidade =
            document.getElementById("btnDisponibilidade");

        const inputDisponivel =
            document.getElementById("Disponivel");

        if (btnDisponibilidade) {

            btnDisponibilidade.addEventListener("click", () => {

                const disponivel =
                    inputDisponivel.value === "true";

                if (disponivel) {

                    inputDisponivel.value = "false";

                    btnDisponibilidade.classList.remove("ativo");
                    btnDisponibilidade.classList.add("inativo");

                    btnDisponibilidade.innerHTML =
                        "🔴 Indisponível";

                }
                else {

                    inputDisponivel.value = "true";

                    btnDisponibilidade.classList.remove("inativo");
                    btnDisponibilidade.classList.add("ativo");

                    btnDisponibilidade.innerHTML =
                        "🟢 Disponível";

                }

            });

        }

    </script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI" crossorigin="anonymous"></script>
</body>

</html>